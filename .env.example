# =============================================================================
# FinTrack AI — Environment Configuration
# Copy to .env and fill in all required (*) values
# Generate secrets: make secret-generate
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Required: POSTGRES_PASSWORD must be set
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=change-me-to-a-strong-password  # *
POSTGRES_DB=fintrack

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-to-a-strong-password      # *

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Required: JWT_SECRET must be set to a strong random value (64+ chars)
# Generate: openssl rand -base64 64 | tr -d '\n' | head -c 64
JWT_SECRET=change-me-to-a-strong-random-secret-64-chars-long-at-least  # *
JWT_ACCESS_EXPIRATION=900000     # 15 min in milliseconds
JWT_REFRESH_EXPIRATION=86400000  # 24 hours in milliseconds

# ─── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ─── Ollama (Local LLM) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=dolphin-phi

# ─── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
VITE_API_URL=/api/v1

# ─── Maven Build ──────────────────────────────────────────────────────────────
MAVEN_PROFILE=production
